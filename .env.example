# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Origin of the surface app, for CORS and Socket.IO.
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# --- Auth --------------------------------------------------------------------
# Required. Use a long random string: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Database ----------------------------------------------------------------
# Embedded SQLite file (node:sqlite). Use :memory: for throwaway runs.
DATABASE_PATH=./data/stellarpos.db
# Automatic snapshots (VACUUM INTO). 0 disables; npm run db:backup takes one now.
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# --- Email ------------------------------------------------------------------
# log (default) prints emails; resend sends receipts via api.resend.com.
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=StellarPOS <receipts@example.com>

# --- Store -------------------------------------------------------------------
STORE_NAME=StellarPOS Demo Store
# ISO 4217 code used for prices and receipts.
STORE_CURRENCY=USD
# Sales tax in basis points (750 = 7.5%).
TAX_RATE_BPS=0

# --- Stellar -----------------------------------------------------------------
# testnet | mainnet
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Public key (G...) that receives customer payments. Never put a secret key here:
# the backend only watches this account, it never signs for it.
STELLAR_MERCHANT_PUBLIC_KEY=
# Asset customers pay in. Leave the issuer empty for native XLM.
STELLAR_ASSET_CODE=USDC
STELLAR_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Store-currency units per 1 asset unit (1 for USDC priced in USD).
STELLAR_ASSET_RATE=1
# Minutes before an unpaid Stellar checkout expires and its stock is released.
STELLAR_PAYMENT_TTL_MINUTES=15
# Poll Horizon for incoming payments and settle matching checkouts automatically.
STELLAR_WATCHER_ENABLED=true
STELLAR_WATCHER_INTERVAL_MS=5000

# Optional: contract IDs from the contracts repo's deployments/<network>.json
STELLAR_PAYMENT_PROCESSOR_ID=
STELLAR_MERCHANT_REGISTRY_ID=
